{
  "name": "dsh-lead-mode",
  "version": "0.2.14",
  "description": "Lead mode for DSH: two agent presets (PTC and creation), a working-method skill, a team digest skill, a dependency self-check, and two opening reminders that tell you to enable the official Agent Teams. | 给 DSH 加 Lead 模式：PTC 与创造两个预置、两个 skill、依赖自检、两条开场提示。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node scripts/validate-names.mjs --manifest ./dsh-plugin.naming.json && node scripts/check-patch.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3"
  },
  "dshTarget": "0.2.2-rc.3",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dshtag",
    "agent-teams",
    "agent-preset",
    "lead-mode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiebaiyuan/dsh-lead-mode.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": ">=0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-commands": ">=0.2.2-rc.3"
  }
}
